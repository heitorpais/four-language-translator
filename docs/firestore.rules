rules_version = '2';
// Glossarium: who may read and write what in the database (Firebase project glossarium-25071).
// Published in the Firebase console under Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function counter() { return /databases/$(database)/documents/meta/members; }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['username', 'avatar', 'nationality', 'speaks', 'learning', 'bio', 'memberNo', 'created', 'updated'])
        && d.username is string && d.username.matches('^[a-z0-9_.]{3,20}$')
        && d.avatar is string && d.avatar.size() < 150000
        && d.nationality is list && d.nationality.size() <= 3
        && d.speaks is list && d.speaks.size() >= 1 && d.speaks.size() <= 20
        && d.learning is list && d.learning.size() <= 20
        && d.bio is string && d.bio.size() <= 200
        && d.memberNo is int && d.created is int && d.updated is int;
    }

    // private: the copy of "My words"
    match /users/{uid} {
      allow read, write: if isMe(uid);
    }

    // public: how many accounts exist; goes up by exactly one when someone creates their profile
    match /meta/members {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.n == 1
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.memberNo == 1;
      allow update: if signedIn() && request.resource.data.n == resource.data.n + 1
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.memberNo == request.resource.data.n;
    }

    // public profiles
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isMe(uid) && validProfile()
        && ((!exists(counter()) && getAfter(counter()).data.n == 1)
            || (exists(counter()) && getAfter(counter()).data.n == get(counter()).data.n + 1))
        && request.resource.data.memberNo == getAfter(counter()).data.n
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isMe(uid) && validProfile()
        && request.resource.data.memberNo == resource.data.memberNo
        && request.resource.data.created == resource.data.created
        && (request.resource.data.username == resource.data.username
            || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid);
      allow delete: if isMe(uid);
    }

    // public: which account a username belongs to (one username per account, no duplicates)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$')
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == name;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username != name);
    }
    // friendships: one document per pair of accounts (id "<a>_<b>", a < b); only the two people can see it.
    // One sends a request (pending), only the other can accept it, either can remove it.
    match /friends/{pair} {
      allow read: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['a', 'b', 'from', 'status', 't'])
        && request.resource.data.a < request.resource.data.b
        && pair == request.resource.data.a + '_' + request.resource.data.b
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in [request.resource.data.a, request.resource.data.b]
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.a))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.b));
      allow update: if signedIn() && resource.data.status == 'pending'
        && request.auth.uid != resource.data.from
        && request.auth.uid in [resource.data.a, resource.data.b]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 't'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in [resource.data.a, resource.data.b];
    }

    // ---------- The Reading Room (forum) ----------
    function isAdmin() { return signedIn() && request.auth.token.email == 'heitorpaisch@gmail.com' && request.auth.token.email_verified == true; }
    function notBlocked() { return !exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function limits() { return /databases/$(database)/documents/limits/$(request.auth.uid); }
    function paced() { return existsAfter(limits()) && getAfter(limits()).data.t == request.time; }
    function nativeIn(lang) {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && {'l': lang, 'lv': 'native'} in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.speaks;
    }
    function authorFields(d) {
      return d.uid == request.auth.uid && d.t == request.time
        && d.username == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && d.native == nativeIn(d.lang)
        && d.body is string && d.body.size() >= 2 && d.body.size() <= 2000
        && d.score == 0 && d.hidden == false;
    }
    function voteDelta(target, field) {
      let vp = /databases/$(database)/documents/threads/$(target)/votes/$(request.auth.uid + '_' + field);
      return (!exists(vp) && existsAfter(vp) && request.resource.data.score == resource.data.score + getAfter(vp).data.v)
          || (exists(vp) && !existsAfter(vp) && request.resource.data.score == resource.data.score - get(vp).data.v);
    }

    // a person's posting pace: one post or reply every 15 seconds at most
    match /limits/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if isMe(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(15, 's');
    }
    // accounts the owner has stopped from posting
    match /blocked/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }
    // what a person follows and when they last looked (private)
    match /follows/{uid} {
      allow read, write: if isMe(uid);
    }
    match /threads/{tid} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow create: if signedIn() && notBlocked() && paced()
        && request.resource.data.keys().hasOnly(['kind', 'section', 'word', 'lemma', 'lang', 'type', 'region', 'title', 'body', 'uid', 'username', 'native', 't', 'lastAt', 'lastBy', 'replies', 'score', 'best', 'hidden'])
        && request.resource.data.kind in ['word', 'forum']
        && request.resource.data.type in ['question', 'tip', 'regional', 'trick', 'example', 'mistake', 'post']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.lastAt == request.time && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.replies == 0 && request.resource.data.best == ''
        && authorFields(request.resource.data);
      allow update: if signedIn() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score']) && resource.data.uid != request.auth.uid && voteDelta(tid, 'thread'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'lastAt', 'lastBy']) && notBlocked() && paced()
              && request.resource.data.replies == resource.data.replies + 1 && request.resource.data.lastAt == request.time && request.resource.data.lastBy == request.auth.uid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['best']) && resource.data.uid == request.auth.uid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'title', 'edited']) && resource.data.uid == request.auth.uid
              && request.resource.data.body.size() <= 2000 && request.resource.data.title.size() <= 120 && request.resource.data.edited == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']) && isAdmin()));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /replies/{rid} {
        allow read: if resource.data.hidden == false || isAdmin();
        allow create: if signedIn() && notBlocked() && paced()
          && request.resource.data.keys().hasOnly(['body', 'uid', 'username', 'native', 'lang', 't', 'score', 'hidden'])
          && request.resource.data.lang == get(/databases/$(database)/documents/threads/$(tid)).data.lang
          && authorFields(request.resource.data);
        allow update: if signedIn() && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score']) && resource.data.uid != request.auth.uid && voteDelta(tid, rid))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'edited']) && resource.data.uid == request.auth.uid && request.resource.data.body.size() <= 2000 && request.resource.data.edited == request.time)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']) && isAdmin()));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
      // one vote per person and post: id "<person>_thread" or "<person>_<reply id>", value +1 or -1
      match /votes/{vid} {
        allow read: if signedIn() && vid.matches(request.auth.uid + '_.*');
        allow create: if signedIn() && vid.matches(request.auth.uid + '_.*') && request.resource.data.keys().hasOnly(['v']) && request.resource.data.v in [1, -1];
        allow delete: if signedIn() && vid.matches(request.auth.uid + '_.*');
      }
    }

    // reports about profiles: anyone signed in can send one; only the owner of the project reads them (in the console)
    match /reports/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['about', 'by', 'why', 't', 'kind', 'thread', 'reply'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.why is string && request.resource.data.why.size() <= 300;
    }
  }
}
